# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/evidence_db?retryWrites=true&w=majority

# Pinata (IPFS pinning service)
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Ethereum RPC used for read calls and the event listener.
# Sepolia (default): https://ethereum-sepolia-rpc.publicnode.com
# Local Hardhat node:  http://127.0.0.1:8545
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional dedicated WebSocket RPC for real-time event listening
RPC_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployed contract address (see blockchain/deployments/<network>.json).
# Sepolia deployment: 0xd2dc06254EC6F920e98e0E5CB4Fc028F3b2a410C
# A local Hardhat deploy always lands at the deterministic address below.
CONTRACT_ADDRESS=0xd2dc06254EC6F920e98e0E5CB4Fc028F3b2a410C

# JWT signing secret for session tokens issued after wallet-signature verification
JWT_SECRET=generate_a_long_random_string_here

# CORS
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000

# Optional DNS resolver override, comma-separated.
# Some Windows setups cannot resolve MongoDB Atlas's SRV records through the
# configured resolver, and the failure does not look like a DNS problem. Leave
# unset unless you hit that; forcing every lookup in the process through a
# public resolver is not a default a server should impose on its host.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# Event listener poll interval in milliseconds. 2000 suits a local Hardhat node;
# on a public testnet RPC use 15000 — Sepolia only produces a block every 12s,
# and faster polling just invites rate limiting.
# EVENT_POLL_INTERVAL_MS=12000

# Throwaway wallet used only by scripts/seed-demo.mjs to register the
# demonstration evidence. It must hold OFFICER on the contract and a little gas.
# Not needed to run the system - only to rebuild the demonstration data.
# SEED_OFFICER_PRIVATE_KEY=0x...

# How long repeated security alerts from one wallet are grouped onto a single
# row instead of filling the feed. Defaults to five minutes.
# ALERT_GROUPING_WINDOW_MS=300000
