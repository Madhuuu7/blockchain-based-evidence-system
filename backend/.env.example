# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/evidence_db?retryWrites=true&w=majority

# Pinata (IPFS pinning service)
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Ethereum Sepolia RPC (used for read calls + event listener)
RPC_URL=http://127.0.0.1:8545/

# Optional dedicated WebSocket RPC for real-time event listening
RPC_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployed contract address (from blockchain/deployments/sepolia.json)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# JWT signing secret for session tokens issued after wallet-signature verification
JWT_SECRET=L1iMP5eTQSTX••••••••••••••dH2rHvN8UJvs

# CORS
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000

# Optional DNS resolver override, comma-separated.
# Some Windows setups cannot resolve MongoDB Atlas's SRV records through the
# configured resolver, and the failure does not look like a DNS problem. Leave
# unset unless you hit that; forcing every lookup in the process through a
# public resolver is not a default a server should impose on its host.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# Event listener poll interval in milliseconds. 2000 suits a local Hardhat node;
# on a public testnet RPC use 15000 — Sepolia only produces a block every 12s,
# and faster polling just invites rate limiting.
# EVENT_POLL_INTERVAL_MS=15000
