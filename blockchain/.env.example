# Sepolia RPC endpoint (Alchemy, Infura, or similar)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployer wallet — NEVER commit the real value.
# Use a dedicated test wallet funded only with Sepolia testnet ETH.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key, used for `hardhat verify`
ETHERSCAN_API_KEY=
